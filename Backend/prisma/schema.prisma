generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model User {
  id                     Int                     @id @default(autoincrement())
  first_name             String
  last_name              String
  password               String
  role                   Role
  phone                  String                  @unique
  email                  String                  @unique
  address                String
  photo                  String?
  status                 Status                  @default(active)
  created_at             DateTime                @default(now())
  update_at              DateTime                @default(now())
  attendances            Attendance[]
  homework               Homework[]
  homeworkAnswerStudents HomeworkAnswerStudent[]
  homeworkResults        HomeworkResult[]        @relation("GradedBy")
  checkedHomeworks       HomeworkResult[]        @relation("CheckedBy")
  lessons                Lessons[]
  exams                  Exam[]
  studentGroups          StudentGroup[]
  teacherGroups          TeacherGroup[]
}

model Course {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  description    String?
  price          Int
  duration_month Int
  duration_hours Int
  color          String
  status         Status   @default(active)
  created_at     DateTime @default(now())
  update_at      DateTime @default(now())
  groups         Group[]
}

model Room {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  capacity   Int
  created_at DateTime @default(now())
  update_at  DateTime @default(now())
  groups     Group[]
}

model Group {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  description   String?
  course_id     Int
  room_id       Int
  start_date    String
  week_day      Json
  start_time    String
  max_student   Int
  status        GroupStatus    @default(active)
  created_at    DateTime       @default(now())
  update_at     DateTime       @default(now())
  courses       Course         @relation(fields: [course_id], references: [id])
  rooms         Room           @relation(fields: [room_id], references: [id])
  homework      Homework[]
  lessons       Lessons[]
  exams         Exam[]
  studentGroups StudentGroup[]
  teacherGroups TeacherGroup[]
}

model StudentGroup {
  id         Int      @id @default(autoincrement())
  group_id   Int
  status     Status   @default(active)
  created_at DateTime @default(now())
  update_at  DateTime @default(now())
  user_id    Int
  groups     Group    @relation(fields: [group_id], references: [id])
  users      User     @relation(fields: [user_id], references: [id])

  @@unique([user_id, group_id])
}

model Lessons {
  id          Int          @id @default(autoincrement())
  group_id    Int
  user_id     Int
  topic       String
  description String?
  video       String?
  status      Status       @default(active)
  created_at  DateTime     @default(now())
  update_at   DateTime     @default(now())
  attendances Attendance[]
  homework    Homework?
  exams       Exam[]
  groups      Group        @relation(fields: [group_id], references: [id])
  users       User         @relation(fields: [user_id], references: [id])
}

model Attendance {
  id         Int      @id @default(autoincrement())
  user_id    Int
  lesson_id  Int
  student_id Int
  isPresent  Boolean
  created_at DateTime @default(now())
  update_at  DateTime @default(now())
  lessons    Lessons  @relation(fields: [lesson_id], references: [id])
  users      User     @relation(fields: [user_id], references: [id])
}

model Homework {
  id                     Int                     @id @default(autoincrement())
  user_id                Int
  lesson_id              Int                     @unique
  group_id               Int
  title                  String
  file                   String?
  created_at             DateTime                @default(now())
  update_at              DateTime                @default(now())
  groups                 Group                   @relation(fields: [group_id], references: [id])
  lessons                Lessons                 @relation(fields: [lesson_id], references: [id])
  users                  User                    @relation(fields: [user_id], references: [id])
  homeworkAnswerStudents HomeworkAnswerStudent[]
}

model HomeworkAnswerStudent {
  id              Int             @id @default(autoincrement())
  user_id         Int
  homework_id     Int
  title           String
  file            String?
  status          HomeworkStatus  @default(PENDING)
  created_at      DateTime        @default(now())
  update_at       DateTime        @default(now())
  homework        Homework        @relation(fields: [homework_id], references: [id])
  user            User            @relation(fields: [user_id], references: [id])
  homeworkResults HomeworkResult[]
}

model HomeworkResult {
  id                    Int                   @id @default(autoincrement())
  homework_answer_id    Int
  user_id               Int
  checked_by            Int
  title                 String
  score                 Int                   @default(0)
  status                HomeworkStatus        @default(PENDING)
  created_at            DateTime              @default(now())
  update_at             DateTime              @default(now())
  homeworkAnswerStudent HomeworkAnswerStudent @relation(fields: [homework_answer_id], references: [id])
  gradedUser            User                  @relation("GradedBy", fields: [user_id], references: [id])
  checkedByUser         User                  @relation("CheckedBy", fields: [checked_by], references: [id])
}

model Exam {
  id          Int      @id @default(autoincrement())
  user_id     Int
  lesson_id   Int
  group_id    Int
  title       String
  file        String?
  created_at  DateTime @default(now())
  update_at   DateTime @default(now())
  groups      Group    @relation(fields: [group_id], references: [id])
  lessons     Lessons  @relation(fields: [lesson_id], references: [id])
  users       User     @relation(fields: [user_id], references: [id])
}

model TeacherGroup {
  id         Int      @id @default(autoincrement())
  group_id   Int
  status     Status   @default(active)
  created_at DateTime @default(now())
  update_at  DateTime @default(now())
  user_id    Int
  groups     Group    @relation(fields: [group_id], references: [id])
  users      User     @relation(fields: [user_id], references: [id])

  @@unique([user_id, group_id])
}

enum CourseLevel {
  beginner
  intermediate
  advanced
}

enum Role {
  SUPERADMIN
  ADMIN
  TEACHER
  STUDENT
  ASSISTANT
}

enum StudentStatus {
  active
  inactive
  freeze
  graduated
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum Status {
  active
  inactive
  freeze
}

enum GroupStatus {
  planned
  active
  completed
}

enum HomeworkStatus {
  PENDING
  CHECKED
  INCOMPLETE
  REJECTED
}
